<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Enhanced Site Info Card with Material 3 Design -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectSTP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Redesigned Top Banner with Gradient Overlay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_gradient"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/sitename"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Site name"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/stpname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:text="STP name"
                            android:textColor="#E6FFFFFF"
                            android:textSize="14sp" />

                        <!-- <TextView
                             android:id="@+id/siteaddress"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:layout_marginTop="4dp"
                             android:fontFamily="@font/poppins_light"
                             android:text="Site_address"
                             android:textColor="#E6FFFFFF"
                             android:textSize="12sp" />-->

                    </LinearLayout>

                    <!-- User Info Panel with Modern Layout -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <!-- User Details -->
                        <LinearLayout
                            android:id="@+id/userDetailsLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <TextView
                                android:id="@+id/personname"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Person name"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/displaydate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Date"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Contact Info (Simple Row Style) -->
                        <LinearLayout
                            android:id="@+id/contactLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@id/userDetailsLayout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_email"
                                    app:tint="@color/on_surface_variant"
                                    android:contentDescription="Email Icon" />

                                <TextView
                                    android:id="@+id/emailText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="email@example.com"
                                    android:textSize="13sp"
                                    android:textColor="@color/on_surface"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_phone"
                                    app:tint="@color/on_surface_variant"
                                    android:contentDescription="Phone Icon" />

                                <TextView
                                    android:id="@+id/phoneText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+91 1234567890"
                                    android:textSize="13sp"
                                    android:textColor="@color/on_surface"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipment Dashboard"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="16sp"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="4dp" />

            <!-- Modern Equipment Cards Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignBounds"
                android:columnOrderPreserved="false">

                <!-- Pumps/Motors Card - Enhanced -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPumpsMotors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:cardBackgroundColor="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <!-- Icon Container with Gradient Background -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainer1"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#E3F2FD"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/motortwo"
                                android:contentDescription="Pumps Motors" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/label1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Pumps / Motors"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/on_surface"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/iconContainer1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Monitor and control"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/label1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Blowers Card - Enhanced -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBlowers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:cardBackgroundColor="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainer2"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#E0F7FA"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/fan"
                                android:contentDescription="Blowers" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/label2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Blowers"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/on_surface"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/iconContainer2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Manage air flow"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/label2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Filters Card - Enhanced -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:cardBackgroundColor="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainer3"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#FCE4EC"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/filter"
                                android:contentDescription="Filters" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/label3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Filters"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/on_surface"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/iconContainer3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Track status"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/label3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Meters Card - Enhanced -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMeters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:cardBackgroundColor="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainer4"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#FFF3E0"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_meter"
                                android:contentDescription="Meters" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/label4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Meters"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/on_surface"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/iconContainer4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Record measurements"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/label4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Sensors Card - Enhanced -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSensors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:cardBackgroundColor="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainer5"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#E8F5E9"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/sensor"
                                android:contentDescription="Sensors" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/label5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Sensors"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/on_surface"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/iconContainer5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Monitor parameters"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/label5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Handover Card - Enhanced -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHandover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:cardBackgroundColor="@color/surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconContainer6"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="34dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:backgroundTint="#FFF9C4"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/handover"
                                android:contentDescription="Handover" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/label6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Handover"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/on_surface"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/iconContainer6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Shift comments"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/label6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
